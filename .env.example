# Copiar para .env e preencher. O .env NUNCA é commitado.

# ── Banco ────────────────────────────────────────────────────────────────
# Docker local (docker-compose) ou Postgres gerenciado (Neon/Supabase).
# Ver TIT-7 — Docker ainda não está configurado nesta máquina.
DATABASE_URL="postgresql://titan:titan@localhost:5432/titan?schema=public"

# ── Blizzard / Battle.net ────────────────────────────────────────────────
# Criar cliente em https://develop.battle.net/access/clients — ver TIT-8
BLIZZARD_CLIENT_ID=""
BLIZZARD_CLIENT_SECRET=""

# Tem que casar EXATAMENTE com uma das redirect URIs registradas no portal,
# byte a byte — barra final, http vs https, porta, tudo.
#
# Não dá para descobrir por sonda: a Blizzard manda para a tela de login antes
# de validar a redirect_uri, e a resposta é idêntica para uma URI válida e uma
# inválida. Ela só valida depois da autenticação, e aí o erro é genérico.
# Se o login falhar no retorno, esta variável é o primeiro suspeito.
BLIZZARD_REDIRECT_URI="http://localhost:3001/auth/battlenet/callback"

# A guilda é US-only. Este é o único lugar onde região é definida — nenhum
# formulário do site pergunta região.
#
# Atenção: região US não quer dizer jogadores americanos. Realms brasileiros
# (Azralon, Goldrinn, Nemesis, Tol Barad...) são região US.
BLIZZARD_REGION="us"

# Guilda a verificar no roster (nome e realm como aparecem no jogo).
# Obrigatórios: sem eles o roster vem vazio e TODO MUNDO é recusado como
# não-membro. A API falha no boot se estiverem em branco.
GUILD_NAME=""
GUILD_REALM=""

# Fuso em que a noite de raid é datada (identificador IANA).
#
# NÃO é preferência de exibição: é o que decide a DATA de uma noite, e a data é
# a chave que casa o log do Warcraft Logs com a raid planejada no WoWAudit.
#
# A raid começa 21:00 BRT, que é 00:00 UTC do dia seguinte. Datando em UTC, 8 de
# cada 20 noites caem no dia errado — e o erro é silencioso: a noite fica sem
# log e todo mundo que raidou vira "Não Raidou".
#
# Não tem relação com BLIZZARD_REGION. A guilda é região US e joga no horário
# de Brasília.
GUILD_TIMEZONE="America/Sao_Paulo"

# Corte de rank para a área interna — ver Regra 4.
#
# Rank 0 é o MAIS ALTO (guild master) e o número cresce descendo a hierarquia,
# então o teste é `rank <= corte`. Com 4, quem é rank 0 a 4 entra; rank 5+ é
# membro da guilda mas não acessa a área interna.
#
# O 4 é o rank de RAIDER. É essa definição que importa, não a contagem de gente
# em cada rank — que oscila toda semana com entrada e saída.
#
# Fica em configuração, e não em constante no código, porque `rank` é a POSIÇÃO
# do rank na lista da guilda, não uma identidade. Reordenar ranks no jogo muda o
# significado do número sem gerar erro nenhum.
GUILD_RANK_ACCESS_MAX="4"

# ── Sessão ───────────────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── Discord ──────────────────────────────────────────────────────────────
# Webhook do canal privado dos oficiais — ver TIT-17
DISCORD_WEBHOOK_URL=""

# ── WoWAudit ─────────────────────────────────────────────────────────────
# Chave por TIME, não por conta, e exige acesso de admin no time. Pegar
# logado no WoWAudit, na página de API do time:
# wowaudit.com/{regiao}/{realm}/{guilda}/{time}/api
#
# Base da API: https://wowaudit.com/v1
# Header: Authorization: Bearer <chave>
# (a chave crua sem "Bearer" também funciona, e existe ?api_key=<chave> na
# query como alternativa — mas a forma documentada é o Bearer.)
#
# Cuidado: https://wowaudit.com/api/v1/... NÃO é a API. É a página de
# marketing em HTML, e ela responde 200 para qualquer caminho, inclusive sem
# chave nenhuma. Se a resposta vier em text/html, você está no lugar errado —
# a API de verdade devolve application/json e 401 sem o header.
#
# O Swagger da própria página de API lista tudo. Duas armadilhas ao sondar
# caminhos na mão, porque o erro parece "endpoint não existe":
#
#   /v1/loot_history/{season_id}   sem o id devolve 404. O season_id vem de
#                                  /v1/period, em current_season.id — não é
#                                  o current_period.
#   /v1/raids                      devolve só as raids futuras. O histórico
#                                  exige /v1/raids?include_past=true
WOW_AUDIT_KEY=""

# ── Warcraft Logs ────────────────────────────────────────────────────────
# Registrar cliente em https://www.warcraftlogs.com/api/clients — ver TIT-27
#
# Usar o fluxo client credentials (API em /api/v2/client), não o de usuário:
# o site consulta em nome dele mesmo, não em nome do jogador.
#
# Rate limit é por PONTOS, não por número de requests — consulta grande custa
# mais. Cachear é a única forma de não estourar (Regra 6).
WARCRAFTLOGS_CLIENT_ID=""
WARCRAFTLOGS_CLIENT_SECRET=""

# ── URLs ─────────────────────────────────────────────────────────────────
API_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
