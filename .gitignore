node_modules/
dist/
build/
.next/
out/

# Env — nunca commitar. Ver .env.example
#
# Padrão amplo de propósito: qualquer .env com sufixo (.bak, .old, .save, cópia
# de editor) contém os mesmos segredos que o original. Este repositório é
# público, então um backup esquecido vaza igual.
# A exceção explícita mantém o .env.example versionado.
.env
.env.*
!.env.example

# Prisma
*.db
*.db-journal

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Testes
coverage/

# Documentos e dados de trabalho local, nunca versionados.
#
# É onde ficam os db2 extraídos do cliente do WoW para a análise de stats de
# item — ver docs/db2-do-cliente.md. O ItemSparse sozinho tem ~59 MB, e dado
# extraído do cliente num repositório público é confusão desnecessária. O que
# vira commit é só o resultado: schema, fórmula e fixtures.
#
# Estava apenas em .git/info/exclude, que protege UMA máquina. Aqui protege
# quem clonar.
localdocs/
