// Ver CLAUDE.md para as regras de arquitetura.
// Acesso a este client SÓ via repository de módulo — nenhum service importa
// PrismaClient direto.

generator client {
  provider = "prisma-client-js"
}

// A connection string vive em prisma.config.ts — a partir do Prisma 7 o campo
// `url` não é mais aceito aqui.
datasource db {
  provider = "postgresql"
}

/// Presença no roster da guilda.
///
/// NÃO é o mesmo que ter acesso: quem responde isso é o rank, contra o corte
/// de `GUILD_RANK_ACCESS_MAX`. Ver Regra 4 do CLAUDE.md.
enum Membership {
  member
  not_member
}

/// Conta Battle.net que já fez login pelo menos uma vez.
///
/// Não guarda senha (o login é OAuth) nem token da Blizzard.
model User {
  id String @id @default(cuid())

  /// `sub` do token da Blizzard. Identificador estável da conta Battle.net,
  /// diferente do battletag, que a pessoa pode trocar.
  battlenetId String @unique

  /// Nome#1234. Muda quando a pessoa troca, então é só exibição.
  battletag String

  membership Membership @default(not_member)

  /// NÃO existe coluna `isOfficer` aqui, e isso é decisão, não esquecimento.
  ///
  /// Ser oficial é derivado de `OfficerGrant` a cada leitura de sessão, porque
  /// a permissão precisa poder ser dada ANTES do primeiro login — e conta só
  /// existe depois do OAuth. Guardar uma cópia aqui criaria duas verdades e um
  /// jeito silencioso de revogar um oficial sem ele perder o acesso.

  /// MELHOR rank entre os personagens da conta no roster — menor número é mais
  /// alto, e rank 0 é o guild master. Derivado de `characters`, desnormalizado
  /// aqui porque o guard consulta isso a cada request.
  ///
  /// Nulo quando a conta não tem nenhum personagem no roster.
  guildRank Int?

  /// Todos os personagens da conta que estão no roster.
  characters GuildCharacter[]

  /// Última confirmação contra o roster. Nulo = nunca verificado.
  verifiedAt DateTime?

  sessions Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

/// Personagem da conta que está no roster da guilda.
///
/// É tabela, e não colunas no User, porque uma conta tem N personagens na
/// guilda e o rank da pessoa é o MELHOR entre eles. Guardar um personagem só
/// fazia o job de revalidação revogar acesso de membro legítimo quando um alt
/// saía da guilda — silenciosamente, e a pessoa só descobria ao tentar entrar.
///
/// Guardar isto é o que permite revalidar usando só a credencial da aplicação
/// (client credentials): basta conferir se estes personagens continuam no
/// roster. Sem isso, revalidar exigiria guardar o refresh token de cada
/// usuário — mais um segredo para proteger, sem ganho.
///
/// LIMITE CONHECIDO, não é bug: a lista só ganha personagens NOVOS no login.
/// O roster da Blizzard não diz de qual conta Battle.net cada personagem é,
/// então descobrir um alt novo exige o token do usuário. Remoção da guilda e
/// mudança de rank continuam sendo detectadas a cada 6h para sempre, mesmo que
/// a pessoa nunca mais logue — nada fica desatualizado por anos.
model GuildCharacter {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Identidade do personagem via toCharacterKey(): minúsculas em NFC, COM
  /// acento. Acento distingue personagens diferentes — Shrëwd, Shrêwd e Shrèwd
  /// são três pessoas com ranks diferentes. Ver Regra 6 do CLAUDE.md.
  nameKey String

  /// Realm via toSlug(). Aqui remover acento é correto: `area-52` e `Area 52`
  /// são o mesmo realm em endpoints diferentes da Blizzard.
  realmSlug String

  /// Nome como a Blizzard exibe, com acento e capitalização. Só para mostrar.
  name String

  /// Rank deste personagem no roster. O rank da PESSOA é o menor entre os dela.
  rank Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// A identidade de um personagem é o par nome + realm, nunca o nome sozinho:
  /// WoW garante nome único por realm, e é justamente por isso que quem acha o
  /// nome ocupado registra uma variação acentuada dele.
  @@unique([userId, realmSlug, nameKey])
  @@index([userId])
  @@index([realmSlug, nameKey])
}

/// Personagem que a liderança marcou como oficial.
///
/// É a lista MANUAL da Regra 4 — a única fonte de verdade sobre quem é oficial.
/// Deliberadamente não derivada de rank: rank é posicional, e reordenar rank no
/// jogo não pode promover ninguém a ver Discord tag e Battle.tag de candidato.
///
/// A concessão é por PERSONAGEM, e não por conta, porque conta só existe depois
/// do primeiro login e a liderança precisa poder preparar a lista antes disso.
/// O casamento com a conta acontece na leitura da sessão, via
/// `isOfficerByGrants()` do shared: qualquer personagem da conta que case com
/// qualquer grant basta — a mesma agregação por pessoa do resto da Regra 4.
///
/// Revogar é apagar a linha, e o efeito é imediato na próxima requisição: nada
/// fica em cache no User. Mesma lógica da sessão com estado no banco.
model OfficerGrant {
  id String @id @default(cuid())

  /// Identidade do personagem via toCharacterKey(): minúsculas em NFC, COM
  /// acento — Shrëwd e Shrêwd são pessoas diferentes. Ver Regra 6.
  nameKey String

  /// Realm via toSlug(), igual ao GuildCharacter, para os dois casarem.
  realmSlug String

  /// Nome e realm como a Blizzard exibe. Só para a tela.
  name  String
  realm String

  /// Battletag de quem concedeu, e quando. Promover alguém a ver dado pessoal
  /// de centenas de candidatos não pode ser uma ação anônima.
  grantedBy String
  grantedAt DateTime @default(now())

  /// Um grant por personagem. Conceder duas vezes atualiza, não duplica.
  @@unique([realmSlug, nameKey])
  @@index([realmSlug, nameKey])
}

/// Sessão com estado no banco, não JWT.
///
/// É o que permite cortar acesso na hora quando alguém sai da guilda. Com JWT
/// sem revogação, um ex-membro continuaria dentro até o token expirar.
model Session {
  /// Valor aleatório que vai no cookie httpOnly. Nunca previsível.
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

/// Season de Mythic+, como a Blizzard numera.
///
/// A season é o gatilho de "o tier virou": o id muda quando ela começa de
/// verdade, e não quando o patch entra — os dois não coincidem. Em 2026 o patch
/// 12.1 entra em 11/08 e a season só começa em 18/08.
///
/// NÃO calcular a próxima como `atual + 1`: o index da Blizzard devolve
/// 1..15 e 17 — a season 16 não existe.
model GameSeason {
  /// Id da Blizzard. Não é sequencial e não é nosso.
  id Int @id

  /// "Midnight Season 1".
  name String

  /// Rótulo que a guilda reconhece: "12.0". Vem do servidor de patch e é
  /// APENAS exibição — nunca decide nada. Nulo se a fonte falhar.
  patch String?

  /// Primeiro period da season. `periodCorrente - firstPeriod + 1` é a semana.
  firstPeriod Int

  /// Quantos periods a season tem até agora.
  periodCount Int

  startedAt DateTime

  snapshots CharacterSnapshot[]

  /// Raids cadastradas no catálogo desta season. A ligação é OPCIONAL do outro
  /// lado — ver o comentário em `CatalogRaid.seasonId`.
  catalogRaids CatalogRaid[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

/// Noite de raid, como a guilda a planejou no WoWAudit.
///
/// A AUTORIDADE sobre "isso foi noite de raid" é o calendário do WoWAudit, não
/// o Warcraft Logs. Quem sobe log é jogador, e sobe o que quiser: existe log de
/// run de alt, de dungeon de M+ e de raid avulsa. A guilda declara a raid quando
/// marca; o log é só a evidência do que aconteceu nela.
model RaidNight {
  /// Id da raid no WoWAudit.
  id Int @id

  /// Data de calendário no fuso da GUILDA (`GUILD_TIMEZONE`), "2026-07-28".
  ///
  /// String, e não DateTime, de propósito: isto é uma data de calendário, não
  /// um instante. Guardar como timestamp reintroduziria o fuso que a chave
  /// justamente elimina — e a raid começa 21:00 BRT, que já é o dia seguinte
  /// em UTC.
  date String

  title      String
  instance   String
  difficulty String

  /// Run extra / de alt.
  ///
  /// Gravada sempre, contada separado: comparar quem foi a uma run de alt com
  /// quem foi à raid do core distorce os dois lados. Descartar seria injusto ao
  /// contrário — quem aparece nas opcionais está se dedicando.
  optional Boolean @default(false)

  seasonId Int?

  /// Relatórios do WCL casados com esta noite, pela data. Vazio = sem log.
  reportCodes String[]

  /// Pulls de boss somadas dos logs da noite. Null = noite sem log.
  bossPulls Int?

  /// A noite tem lista de signup?
  ///
  /// O WoWAudit só devolve signups a partir de 2026; as 83 noites de 2024–2025
  /// vêm com a lista vazia. Sem esta flag, o backfill afirmaria que essa gente
  /// toda "apareceu sem confirmar" — indisciplina inventada a partir de dado
  /// que não existe.
  hasSignups Boolean @default(false)

  attendance RaidAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([seasonId])
}

/// O que aconteceu com um personagem numa noite de raid.
///
/// Guarda o FATO OBSERVÁVEL, nunca a interpretação. O estado derivado sai de
/// `toAttendanceState()` no shared, para o job e a tela não divergirem.
model RaidAttendance {
  id String @id @default(cuid())

  raidNightId Int
  raidNight   RaidNight @relation(fields: [raidNightId], references: [id], onDelete: Cascade)

  /// Identidade: nome + realm. Ver Regra 6 — nome sozinho colide.
  nameKey String

  /// Realm por `toRealmMatchKey()`, NÃO por `toSlug()`.
  ///
  /// Aqui a linha nasce de duas fontes que escrevem realm diferente: o signup
  /// do WoWAudit diz "Area 52" e o log do WCL diz "Area52". Por `toSlug()` isso
  /// viraria `area-52` e `area52` — duas linhas para a mesma pessoa na mesma
  /// noite, uma "confirmou e sumiu" e outra "raidou sem confirmar".
  ///
  /// Para cruzar com `GuildCharacter`, aplique `toRealmMatchKey()` no
  /// `realmSlug` de lá — a função é idempotente sobre o slug.
  realmKey String

  /// Nome exibido, com acento.
  name String

  /// Realm exibido, na forma da fonte que a guilda reconhece.
  realm String

  /// Status auto-declarado no signup. Null = a pessoa não estava no signup.
  signup String?

  /// Apareceu em alguma pull de boss.
  ///
  /// **NULL quando a noite não tem log** — e null NÃO é false. Log pode chegar
  /// dias depois, ou nunca; tratar ausência de log como falta acusaria a raid
  /// inteira de furar.
  raided Boolean?

  /// Em que pull de boss entrou (1 = a primeira). Sinal de atraso, não prova:
  /// "entrou na pull 5" pode ser rodízio normal.
  firstPull Int?

  /// Em quantas pulls de boss apareceu.
  pulls Int?

  /// Motivo anotado pelo raid leader, à mão.
  ///
  /// É a CORREÇÃO DO HUMANO, e o job **nunca** a sobrescreve ao reprocessar a
  /// noite. Sistema que decide sozinho a reputação de alguém erra em público, e
  /// a liderança para de confiar nele.
  note   String?
  noteBy String?
  noteAt DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Uma linha por personagem por noite. Reprocessar atualiza, não duplica.
  @@unique([raidNightId, realmKey, nameKey])
  @@index([realmKey, nameKey])
}

/// Foto semanal de um personagem do time de raid.
///
/// Existe porque as APIs externas respondem "como está agora" e nenhuma
/// responde "como estava em março". A linha do tempo só existe se a gente
/// gravar — semana não gravada não volta.
///
/// A chave temporal é o **period da Blizzard**, não uma data nossa: period é a
/// semana do jogo, já alinhada ao reset da região, então não há fuso nem
/// ambiguidade de virada de semana.
model CharacterSnapshot {
  id String @id @default(cuid())

  /// Semana do jogo.
  period Int

  seasonId Int
  season   GameSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  /// Identidade: nome + realm. Ver Regra 6 — nome sozinho colide.
  nameKey   String
  realmSlug String

  /// Nome exibido, com acento.
  name String

  /// `gear.item_level_equipped` do Raider.IO. Nulo = não deu para medir na
  /// semana. NUNCA gravar 0 no lugar: "sem dado" e "sem gear" são coisas
  /// diferentes, e o gráfico tem que mostrar lacuna.
  itemLevel Float?

  /// Score de M+ da season.
  mythicPlusScore Float?

  /// Quantas keys a pessoa fechou na semana, do WoWAudit.
  keysDone Int?

  /// Maior nível de key na semana. Distingue 3 keys +10 de 3 keys +2.
  highestKey Int?

  /// Total ACUMULADO de M+ na season, do Raider.IO.
  ///
  /// Diferente de `keysDone`, que é a semana. Este número é completo — o
  /// Raider.IO acumula desde o início da season — enquanto a soma semanal do
  /// WoWAudit só cobre o período em que ele acompanhava o time.
  ///
  /// Guardado toda semana de propósito: a diferença entre duas semanas dá a
  /// atividade real do intervalo, sem depender do WoWAudit.
  seasonRuns Int?

  /// Quantas do acumulado foram no tempo.
  seasonRunsTimed Int?

  recordedAt DateTime @default(now())

  /// Uma foto por personagem por semana. Rodar o job duas vezes atualiza a
  /// linha, não cria outra.
  @@unique([period, realmSlug, nameKey])
  @@index([seasonId])
  @@index([realmSlug, nameKey])
}

/// Dificuldade de raid, como contexto do catálogo.
///
/// NÃO é derivada do `itemString`. Isso foi testado nos 445 registros da season
/// passada: dos 112 itens de raid, 75 aparecem em mais de uma dificuldade, e só
/// UM bonus ID (`13786`, Flexible Raiding) separa limpo. O mesmo item 249276 em
/// Heroic e Normal compartilha os bonus `13333` e `12786` — o conjunto varia por
/// socket, terciário, track de upgrade e caminho de aquisição, não por
/// dificuldade.
///
/// E não precisa ser derivada: quem cadastra está lendo a loot table Mítica no
/// Wowhead e já sabe que é mítica.
///
/// LFR ficou de fora porque a guilda não roda. Acrescentar valor a enum depois é
/// migration barata; o inverso, não.
enum RaidDifficulty {
  normal
  heroic
  mythic
}

/// Stat primário de uma peça. Ver `primaryStatSchema` no shared.
enum PrimaryStat {
  strength
  agility
  intellect
}

/// Specs do jogo, com o slug prefixado pela classe.
///
/// Duplica `SPECS` do `packages/shared` de propósito, no mesmo padrão de
/// `RaidDifficulty`: o banco valida o que a curadoria grava, e o typecheck pega
/// a divergência na função de tradução do service. Errar de digitação aqui é
/// exatamente o tipo de coisa que estraga dado curado à mão.
///
/// Prefixo obrigatório porque o nome sozinho colide: `restoration` é de druida e
/// de xamã, `holy` de paladino e sacerdote, `frost` de mago e death knight,
/// `protection` de paladino e guerreiro.
enum WowSpec {
  death_knight_blood
  death_knight_frost
  death_knight_unholy
  demon_hunter_havoc
  demon_hunter_vengeance
  druid_balance
  druid_feral
  druid_guardian
  druid_restoration
  evoker_augmentation
  evoker_devastation
  evoker_preservation
  hunter_beast_mastery
  hunter_marksmanship
  hunter_survival
  mage_arcane
  mage_fire
  mage_frost
  monk_brewmaster
  monk_mistweaver
  monk_windwalker
  paladin_holy
  paladin_protection
  paladin_retribution
  priest_discipline
  priest_holy
  priest_shadow
  rogue_assassination
  rogue_outlaw
  rogue_subtlety
  shaman_elemental
  shaman_enhancement
  shaman_restoration
  warlock_affliction
  warlock_demonology
  warlock_destruction
  warrior_arms
  warrior_fury
  warrior_protection
}

/// Dicionário de itens: "o que é o item 249276".
///
/// NÃO é a loot table da raid — isso é `EncounterDrop`. A distinção importa: dos
/// 445 registros do histórico, 17 são de Mythic Keystone e 86 são bonus roll,
/// itens que nunca vão estar em `EncounterDrop`. Se o dicionário só cobrisse
/// item de raid, o explorador exibiria M+ com o nome localizado que ele existe
/// para eliminar.
///
/// Por isso a tabela é COMPARTILHADA: o cadastro manual do catálogo escreve
/// aqui, e o import do histórico também.
///
/// Cresce para sempre e nunca apaga: linha de loot e sessão guardam `itemId`, e
/// apagar um item apagaria o significado de histórico já gravado.
model CatalogItem {
  /// Id da Blizzard, chave natural. Sem surrogate: o import já chega com o
  /// `itemID` na mão, e PK natural transforma o import em upsert direto.
  /// Mesmo precedente do `GameSeason.id`.
  itemId Int @id

  /// Nome canônico em **en_US**, escolhido por casar com Wowhead, WarcraftLogs
  /// e Raider.IO — as fontes que a gente confere contra.
  ///
  /// A TELA SEMPRE LÊ DAQUI, nunca o `itemName` da linha de loot: aquele vem
  /// localizado pelo cliente de quem era loot master na noite, então o mesmo
  /// item aparece em dois idiomas na mesma lista.
  ///
  /// Nulo até o enriquecimento rodar. É nulável de propósito: item de patch não
  /// lançado responde 404 na API live, e o cadastro precisa funcionar antes
  /// disso — a season começa em 18/08/2026 e o patch só entra em 11/08.
  name String?

  /// Slug do ícone (`inv_helm_plate_raidwarrior_a_01`), não URL.
  /// URL de CDN muda de host e formato; o slug é estável há mais de uma década
  /// e a URL se compõe na hora de exibir.
  icon String?

  /// `INVTYPE_*` da Blizzard — o slot. Constante, e **não** localizado.
  ///
  /// Deliberadamente não é o `subType` do export do RCLootCouncil, que vem
  /// traduzido pelo cliente e reintroduziria o problema do nome localizado.
  equipLoc String?

  /// Tipo do item (subclasse: `Plate`, `Trinket`, `One-Handed Sword`).
  itemSubclass String?

  /// Quando a API da Blizzard preencheu os campos acima. Nulo = nunca
  /// enriquecido, e é isso que o job procura para tentar de novo.
  enrichedAt DateTime?

  /// Stats primários da peça, cadastrados à mão.
  ///
  /// Conjunto e não valor único, porque os quatro casos são reais: stat fixo
  /// (`[strength]`), grupo restrito (`[strength, agility]`, comum em trinket),
  /// totalmente adaptativa, e sem primário nenhum — trinket que é só efeito.
  primaryStats PrimaryStat[]

  /// Quando um humano revisou a lista de specs. Nulo = ninguém revisou.
  ///
  /// Existe para separar duas coisas que a lista vazia confunde: "ainda não
  /// sabemos" e "nenhuma spec usa". Mesmo princípio da Regra 7 — lacuna nunca é
  /// zero. Sem isto, item recém-cadastrado apareceria como inútil para todos.
  specsCuratedAt DateTime?

  usableBySpecs CatalogItemSpec[]

  drops EncounterDrop[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// O job de enriquecimento varre por aqui.
  @@index([enrichedAt])
}

/// Qual spec pode usar a peça.
///
/// ESTAS LINHAS SUBSTITUEM A DERIVAÇÃO, NUNCA SOMAM A ELA.
///
/// Derivar por tipo de armadura, stat primário e slot dá uma boa proposta, mas
/// erra num caso que não é raro: o EFEITO do item restringe além do que o stat
/// diz. Trinket com intelecto e proc de cura serve healer e não serve mago;
/// trinket com força e redução de dano serve tank e não serve Fury.
///
/// Como as restrições reais são de REMOÇÃO, um desenho "derivado + acréscimos
/// manuais" não conseguiria expressar nenhum desses casos — só dá para
/// acrescentar spec, nunca tirar. Por isso o que fica gravado é a resposta final
/// do humano, e a derivação vive na tela de cadastro como sugestão.
///
/// É a Regra 7 ao pé da letra: derivar automático, humano corrige, guardar a
/// correção. Ver TIT-77.
model CatalogItemSpec {
  itemId Int
  item   CatalogItem @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  spec WowSpec

  createdAt DateTime @default(now()) @map("created_at")

  @@id([itemId, spec])
  @@index([spec])
}

/// Uma raid do catálogo.
model CatalogRaid {
  id String @id @default(cuid())

  /// Identidade estável para referenciar de fora sem depender do cuid.
  slug String @unique

  /// "The Voidspire".
  name String

  /// `instanceMapID` do cliente, como o addon emite no cabeçalho da colagem.
  ///
  /// É CONFERÊNCIA, não chave de casamento: achar o boss pelo
  /// `dungeonEncounterId` já entrega a raid pela FK, então a raid vem de graça.
  /// Guardar isto permite detectar colagem cujo `instance` não corresponde à raid
  /// do boss — sinal de dado estranho, que é melhor notar do que ignorar.
  ///
  /// CUIDADO: não é o mesmo espaço de id da zona do Warcraft Logs. Aberrus é
  /// `2569` aqui e zona `33` no WCL. Só o id de ENCOUNTER coincide entre as duas
  /// fontes; comparar estes números com os do WCL erra em silêncio.
  instanceMapId Int?

  /// Season da Blizzard, **opcional de propósito**.
  ///
  /// `GameSeason` é populada pelo job de snapshot a partir de
  /// `getCurrentSeason()`, então a linha da season nova só existe depois que ela
  /// COMEÇA. Como o catálogo precisa estar pronto ANTES disso — é o motivo de
  /// ele ser a primeira coisa a construir — uma FK obrigatória impediria
  /// cadastrar justamente na janela em que o cadastro serve para algo.
  ///
  /// Chutar o id também não é opção: o índice da Blizzard devolveu 1..15 e 17,
  /// e a season 16 não existe.
  ///
  /// Fica nulo no cadastro e é preenchido quando a season aparece.
  seasonId Int?
  season   GameSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  encounters CatalogEncounter[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([seasonId])
}

/// Um boss da raid.
model CatalogEncounter {
  id String @id @default(cuid())

  raidId String
  raid   CatalogRaid @relation(fields: [raidId], references: [id], onDelete: Cascade)

  name String

  /// Ordem do boss na raid, para a tela listar na sequência em que se mata.
  position Int

  /// `dungeonEncounterID` do jogo. É a chave que casa três fontes.
  ///
  /// Verificado em 09/08/2026 contra a API do Warcraft Logs, com sete ids que o
  /// addon emitiu em raid real, de duas expansões: 2688 Kazzara, 2687 The
  /// Amalgamation Chamber, 2693 The Forgotten Experiments, 2032 Goroth, 2048
  /// Demonic Inquisition, 2036 Harjatan, 2037 Mistress Sassz'ine. Sete de sete
  /// com o nome batendo.
  ///
  /// Ou seja: o `ENCOUNTER_END` do jogo e o WCL usam o MESMO espaço de id. Uma
  /// coluna resolve três coisas — casar a colagem do addon com o boss, casar a
  /// progressão que o `warcraftlogs.service.ts` já busca, e dar identidade
  /// estável ao boss em vez de depender do nome, que é localizado.
  ///
  /// NÃO é o `journalEncounterID` do Encounter Journal, que é outro espaço de id.
  /// Cadastrar o número de lá faria a colagem não casar com boss nenhum, sem erro.
  ///
  /// Único de propósito: dois bosses com o mesmo id seria ambiguidade na hora de
  /// casar a colagem, e é melhor o banco recusar do que a sessão escolher um dos
  /// dois. Nulo enquanto o cadastro não tiver o número.
  dungeonEncounterId Int? @unique

  drops EncounterDrop[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Sem `@@index` para o `dungeonEncounterId`: o `@unique` dele já cria índice
  /// no Postgres, e um segundo seria peso morto na escrita.
  @@unique([raidId, position])
  @@index([raidId])
}

/// A loot table: este boss solta este item nesta dificuldade.
///
/// A dificuldade é atributo DESTA linha, e não da raid nem do boss, porque a
/// loot table muda entre dificuldades. Os "28 pares boss+dificuldade" da season
/// passada saem como `DISTINCT (encounterId, difficulty)` — o par não vira
/// tabela porque não tem atributo próprio.
///
/// MODIFICADORES NÃO ENTRAM AQUI. Socket, terciário e track variam por drop, não
/// por entrada de catálogo; enumerar combinações seria explosão combinatória sem
/// ganho. Eles vivem no `itemString` cru da linha de loot.
model EncounterDrop {
  encounterId String
  encounter   CatalogEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  difficulty RaidDifficulty

  itemId Int
  item   CatalogItem @relation(fields: [itemId], references: [itemId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  /// Sem id próprio: a trinca já é a identidade, e nada referencia um drop.
  /// A sessão ao vivo e a linha de loot guardam `itemId`, não esta linha — que é
  /// o que faz editar o catálogo nunca corromper histórico já gravado.
  @@id([encounterId, difficulty, itemId])
  @@index([itemId])
}
